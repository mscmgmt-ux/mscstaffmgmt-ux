# =============================================================
# .gitignore
#
# このリポジトリは GitHub の public リポジトリである。
# ここに書かれたファイルは「コミットしてはいけないもの」であり、
# 除外し忘れると全世界に公開される。
#
# ワイルドカード（*.env など）は使わない。
# .env.example のような公開してよいファイルを巻き込むため、
# 実ファイル名を列挙する。
# 新しい秘密情報ファイルを作るときは、先にここへ追記すること。
# =============================================================

# --- clasp（GAS の認証情報・プロジェクト識別子）-----------------
# .clasprc.json は Google の OAuth トークン。漏洩すると
# GAS・スプレッドシート・Gmail を第三者が操作できる。
.clasprc.json
.clasp.json
gas/.clasp.json
gas/.clasprc.json

# --- ローカル設定（GAS Web App URL・4桁コード・許可メール）------
# 本番/開発の切り替え値もここに入る。
config.local.js
config.local.json
js/config.local.js
gas/config.local.js
secrets.local.json

# --- スタッフデータ・メールアドレス一覧 -------------------------
staff.csv
staff.json
staff_list.csv
staff_list.json
emails.csv
emails.txt
スタッフ名簿.csv
スタッフ名簿.xlsx

# --- スプレッドシートの書き出し・バックアップ -------------------
# 回答内容・氏名・メールを含むため、リポジトリに置かない。
backup/
export/

# --- ホテル提出ファイル -----------------------------------------
# 宿泊者の氏名を含む。版管理は Drive 側で行う。
hotel_export/
hotel_submission/

# --- Node.js（テスト実行用）-------------------------------------
# package-lock.json は「除外しない」。開発者不在で運用するため、
# 依存関係を再現できる状態でコミットしておく。
node_modules/

# --- macOS -------------------------------------------------------
.DS_Store
